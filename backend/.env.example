# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Local dev example: postgresql://postgres:postgres@localhost:5432/quizipedia_dev
DATABASE_URL=postgresql://user:password@localhost:5432/quizipedia_dev

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Secret used to sign JWT auth tokens. Generate a real random value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the same secret across dev/staging/production, and never
# commit a real value.
JWT_SECRET_KEY=change-me-to-a-random-secret

# Comma-separated list of origins allowed to call this API.
# In production this should be your deployed frontend's exact origin(s),
# not "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: environment name, used for log formatting / debug toggles.
ENVIRONMENT=development
