# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Local dev example: postgresql://postgres:postgres@localhost:5432/quizipedia_dev
DATABASE_URL=postgresql://user:password@localhost:5432/quizipedia_dev

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated list of origins allowed to call this API.
# In production this should be your deployed frontend's exact origin(s),
# not "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: environment name, used for log formatting / debug toggles.
ENVIRONMENT=development
